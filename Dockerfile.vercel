FROM php:8.3-apache

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq-dev \
    && docker-php-ext-install pdo_pgsql pdo_sqlite \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www/html
COPY . /var/www/html

CMD ["sh", "-c", "port=${PORT:-80}; sed -i \"s/Listen 80/Listen $port/\" /etc/apache2/ports.conf; sed -i \"s/:80>/:$port>/\" /etc/apache2/sites-enabled/000-default.conf; exec apache2-foreground"]
